ebkit-mask-size:100% 100%}.paper.left{left:0;background-position:left center}.paper.right{left:50%;background-position:right center}#left,#right{z-index:3;cursor:pointer}#leaf{position:absolute;left:50%;top:0;width:50%;height:100%;transform-origin:0 50%;transform-style:preserve-3d;z-index:6;pointer-events:none;will-change:transform}#leaf[hidden]{display:none!important}.face{position:absolute;inset:0;width:100%;height:100%;backface-visibility:hidden;-webkit-backface-visibility:hidden}.face.right{left:0;transform:translateZ(.12px)}.face.back{transform:rotateY(180deg) translateZ(.12px);left:0}#cover{position:absolute;left:50%;top:0;width:50%;height:100%;z-index:12;transform-origin:0 50%;transform-style:preserve-3d;cursor:pointer}#cover[hidden]{display:none!important}.cover-front,.cover-back{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;transform-style:preserve-3d}.cover-front{transform:translateZ(.4px);overflow:visible}#cover-art{position:absolute;left:-18%;top:-.7%;width:118.64%;height:105%;max-width:none;object-fit:fill;pointer-events:none;user-select:none}.cover-back{transform:rotateY(180deg) translateZ(.4px);mask-size:200% 100%;mask-position:left center;mask-repeat:no-repeat;-webkit-mask-size:200% 100%;-webkit-mask-position:left center;-webkit-mask-repeat:no-repeat}.back-frame{position:absolute;inset:0;background-repeat:no-repeat;background-size:200% 100%;background-position:left center}.back-paper.paper{width:100%;height:100%;left:0}.closed #frame,.opening #frame,.closing-book #frame{clip-path:inset(0 0 0 50%)}.closed #left,.opening #left,.closing-book #left{visibility:hidden}#learn{position:absolute;left:60.7%;top:79.8%;width:17%;height:5.2%;border:0;padding:0;background:transparent;z-index:10;border-radius:20%;transition:box-shadow .15s}#learn:hover{background:#d6b16d14;box-shadow:0 0 12px #b583c24d}#learn:focus-visible{outline:2px solid #e7bf79;outline-offset:2px}#learn[hidden]{display:none!important}#loading{position:absolute;inset:0;display:grid;place-items:center;background:#1b2022e8;z-index:40;font-style:italic;color:#d1b98d}#loading[hidden]{display:none!important}footer{height:68px;border-top:1px solid #b4985b22;background:#11171b80;padding:0 4vw;display:flex;align-items:center;justify-content:space-between;gap:20px}footer button{font-size:12px}#help{font-size:11px;color:#aaa698;min-width:190px}.nav{display:flex;align-items:center;gap:24px}.counter{text-align:center;min-width:155px}.counter strong{display:block;font-size:11px;letter-spacing:2px;color:#c7ac7d;font-weight:normal}.counter span{display:block;font-size:12px;color:#bbb7aa;margin-top:5px}.preview-note{height:30px;line-height:30px;text-align:center;font-size:10px;letter-spacing:1px;color:#8c8e86}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}#toast{position:fixed;left:50%;bottom:110px;transform:translateX(-50%);font-size:13px;background:#271e2bea;color:#e2c99d;border:1px solid #9f83575c;border-radius:4px;pointer-events:none;padding:12px 20px;opacity:0;transition:opacity .16s;z-index:50}#toast.visible{opacity:1}.compact #stage{position:fixed;right:0;bottom:.5vh;width:min(35vw,54vh)}.compact #book.closed{transform:none}.compact #help{visibility:hidden}@media(max-width:800px){header{height:64px;padding:10px 3vw}h1{font-size:15px}.heading span{font-size:7px;letter-spacing:1.5px}.tools label,#size{display:none}select{font-size:11px;max-width:170px}.tools{gap:6px}main{height:calc(100dvh - 158px)}#stage{width:min(99vw,calc((100dvh - 162px)*1.5))}#help{display:none}footer{height:64px;padding:0 3vw;gap:8px}.nav{gap:10px;flex:1;justify-content:space-between}.counter{min-width:100px}.counter span{font-size:10px}footer button{padding:8px;font-size:11px}#close{display:none}#toast{font-size:11px;width:max-content;max-width:90vw;text-align:center}}@media(prefers-reduced-motion:reduce){#book{transition-duration:120ms}}
+
+/* Natural binding: the existing artwork, never a generated duplicate silhouette.
+   The original cover raster contains the spine in its first 13.4%. We isolate
+   that pixel-identical region and keep it BEHIND the paper and page frame. */
+#spine-recess{position:absolute;inset:0 50% 0 0;overflow:hidden;z-index:2;pointer-events:none}
+#spine-retreat{position:absolute;left:82%;top:0;width:18%;height:100%;
+  z-index:2;pointer-events:none;transform:translateX(65%);
+  clip-path:inset(0 0 0 100%);will-change:transform,clip-path;
+  transition:transform 1120ms cubic-bezier(.4,.05,.18,1),
+             clip-path 1120ms cubic-bezier(.4,.05,.18,1)}
+#spine-retreat img{position:absolute;left:0;top:-.7%;width:659.111%;height:105%;
+  max-width:none;object-fit:fill;pointer-events:none}
+/* The cover always contains only its front board, no bound-spine pixels. */
+#cover-art{clip-path:inset(0 0 0 13.4%)}
+/* Closed book: the intact spine rests in its original place. */
+#book.closed #spine-retreat{transform:translateX(0);clip-path:inset(0 0 0 0)}
+/* During opening and closing it is consumed by the book's own page envelope.
+   Keep its layer below papers at all times so it cannot overlay the gutter. */
+@media(prefers-reduced-motion:reduce){#spine-retreat{transition-duration:120ms}}
